# مفتاح الوصول من https://numverify.com/product
# اتركه فارغاً لتشغيل المشروع بالتحقق المحلي وحده (بلا أي طلبات خارجية).
NUMVERIFY_ACCESS_KEY=

# HTTPS متاح فقط في الخطط المدفوعة. اتركه false في الخطة المجانية.
NUMVERIFY_HTTPS=false

# استدعاء المزوّد للمشغّل والموقع ونوع الخط.
# اجعله false لتحقق محلي خالص بصفر استهلاك.
ENRICH_WITH_API=true

# يُضاف تلقائياً للأرقام المحلية التي تبدأ بصفر. اتركه فارغاً لتعطيله.
DEFAULT_COUNTRY_CODE=SA

# إعادة محاولة واحدة برمز الدولة الافتراضي إذا فشل التحقق لدى المزوّد.
AUTO_RETRY=true

# الكاش يمنع استهلاك طلب جديد لنفس الرقم
CACHE_ENABLED=true
CACHE_TTL=86400
